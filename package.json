  "license": "MIT",
  "author": "NabuxAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NabuxAi/gap-mcp.git"
  },
  "homepage": "https://github.com/NabuxAi/gap-mcp#readme",
  "bugs": {
    "url": "https://github.com/NabuxAi/gap-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nabuxai/iranian-messaging-core": "^0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
