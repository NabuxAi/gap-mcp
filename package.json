{
  "name": "@nabuxai/gap-mcp",
  "version": "0.1.0",
  "description": "MCP server for Gap (گپ): the official bot API and the user's own account through Gap Web, with safety locks on every write.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "gap-mcp": "bin/gap-mcp.mjs"
  },
